# Local development only. Copy to .env and fill in THROWAWAY values.
#
#   cp .env.example .env
#
# .env is gitignored. Never put your production Discord webhook or the real
# Vast webhook_secret in here — in AWS these come from SSM Parameter Store
# SecureString and are never present in the environment.
#
# When these two variables are set, src/config.ts uses them directly and makes
# no AWS calls at all. That is what makes `sam local` and the unit tests work
# without credentials.

# A Discord webhook pointing at a private test channel you don't mind spamming.
# Create one: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me

# Any random string. scripts/sign-payload.ts signs local requests with this same
# value, so both sides only need to agree — it does not have to match Vast.
VAST_WEBHOOK_SECRET=local-development-secret-not-a-real-one
